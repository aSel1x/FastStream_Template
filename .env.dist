# Copy this file to `.env` and adjust values before running `make build` / `make start`.
# `docker-compose.yaml` reads this file directly; the Makefile also sources it for local
# (non-docker) commands such as `make migration`.

# --- General -----------------------------------------------------------------
# "production" enables HTTPS redirect middleware, disables debug mode, and makes
# ALLOWED_ORIGINS / HYDRA_ADMIN_URL / HYDRA_PUBLIC_URL / APP_SECRET_KEY mandatory.
ENV=development
# Signs CSRF tokens for the Hydra login/consent forms. Required in production.
APP_SECRET_KEY=change-me-to-a-long-random-string

# Encrypts the TOTP seed at rest. Changing it makes every enrolled second factor
# undecryptable, so treat it as durable. Generate: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For. Leave empty when
# nothing sits in front of the app: an untrusted header would let anyone forge their IP, and
# trusting the raw peer behind a proxy makes rate limiting collapse onto a single key.
TRUSTED_PROXIES=

# Host the HTTPS redirect sends browsers to in production. Reflecting the request's own Host
# header instead would be an open redirect.
PUBLIC_HOST=
ALLOWED_HOSTS=
# Public base URL of this API, used to build links in verification/reset emails.
APP_BASE_URL=http://localhost:8000
# Comma-separated list of allowed CORS origins. Required when ENV=production.
ALLOWED_ORIGINS=http://localhost:3000

# --- Postgres (application database) ------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_ECHO=false

# Connection pool. Multiply by the number of replicas and keep the total below Postgres'
# max_connections.
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE_SECONDS=1800
# Server-side statement timeout, so one runaway query cannot pin a connection.
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_APPLICATION_NAME=backend-template

# --- Redis (cache + rate limiting) ---------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CACHE_BACKEND=redis
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_SECONDS=900
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=300
RATE_LIMIT_MAX_KEYS=10000

# --- RabbitMQ (domain event queue) ----------------------------------------------
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_VIRTUALHOST=/

# --- Ory Hydra (OIDC provider) --------------------------------------------------
# Separate Postgres database for Hydra's own state.
HYDRA_POSTGRES_USER=hydra
HYDRA_POSTGRES_PASSWORD=hydra
HYDRA_POSTGRES_DB=hydra
HYDRA_PUBLIC_PORT=4444
# URLs Hydra itself uses (issuer + where it redirects the browser for login/consent/logout).
HYDRA_ISSUER_URL=http://localhost:4444
HYDRA_LOGIN_URL=http://localhost:8000/auth/login
HYDRA_CONSENT_URL=http://localhost:8000/auth/consent
HYDRA_LOGOUT_URL=http://localhost:8000/auth/logout
# Comma-separated system secret(s) Hydra uses to encrypt/sign its own state. Rotate by
# prepending a new secret; keep old ones so existing sessions/tokens stay valid.
HYDRA_SECRETS_SYSTEM=change-me-to-a-long-random-string
# URLs this app uses to talk to Hydra's admin/public APIs (container-to-container in compose).
HYDRA_ADMIN_URL=http://hydra:4445
HYDRA_PUBLIC_URL=http://hydra:4444
HYDRA_LOGIN_REMEMBER_SECONDS=3600
HYDRA_CONSENT_REMEMBER_SECONDS=2592000
HYDRA_INTROSPECTION_CACHE_TTL_SECONDS=30
HYDRA_INTROSPECTION_NEGATIVE_CACHE_TTL_SECONDS=10
HYDRA_REQUEST_TIMEOUT_SECONDS=5.0
# Optional: JSON array of OAuth2 clients to seed into Hydra on startup, e.g.
# OAUTH_SEED_CLIENTS=[{"client_id":"web","client_name":"Web app","redirect_uris":["http://localhost:3000/callback"],"is_confidential":false}]
OAUTH_SEED_CLIENTS=

# --- Initial admin bootstrap -----------------------------------------------------
# UUID of a user (already registered via POST /v1/users/register) to grant the admin
# role to on startup. Leave empty to skip.
INITIAL_ADMIN_USER_ID=

# --- SMTP (verification / password-reset emails) ---------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDR=noreply@example.com

# --- Observability (OpenTelemetry tracing) ----------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=backend-template
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Logging -----------------------------------------------------------------
# json in any deployed environment; "plain" is easier to read while developing.
LOG_LEVEL=INFO
LOG_FORMAT=plain

# --- Maintenance worker ------------------------------------------------------
# Retention. Nothing else in the stack deletes anything, so these decide how far
# the tables grow.
MAINTENANCE_INTERVAL_SECONDS=3600
MAINTENANCE_SESSION_GRACE_DAYS=7
MAINTENANCE_OUTBOX_RETENTION_DAYS=7
MAINTENANCE_AUDIT_RETENTION_DAYS=365
MAINTENANCE_DELETED_USER_DAYS=30
# Log what would be removed without removing it.
MAINTENANCE_DRY_RUN=false
