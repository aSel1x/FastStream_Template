meta {
  name: Verify 2FA
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/auth/2fa/verify
  body: json
  auth: inherit
}

body:json {
  {
    "code": "123456"
  }
}

docs {
  Checks a code against an already-active second factor, for a signed-in user. This is not
  the login step — completing a login challenge is `Complete Challenge`, and activating a new
  enrolment is `Confirm 2FA`.
}
