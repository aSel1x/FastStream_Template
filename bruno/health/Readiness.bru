meta {
  name: Readiness
  type: http
  seq: 2
}

get {
  url: {{base_url}}/health/ready
  body: none
  auth: none
}

docs {
  Checks every dependency a request actually needs: Postgres, the cache, and Hydra. Returns
  503 with a per-dependency breakdown when any of them is down, so it is safe to point a
  Kubernetes readiness probe at.
}
