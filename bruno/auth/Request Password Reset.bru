meta {
  name: Request Password Reset
  type: http
  seq: 4
}

post {
  url: {{base_url}}/v1/auth/request-password-reset
  body: json
  auth: none
}

body:json {
  {
    "email": "ars.seliv@gmail.com"
  }
}

docs {
  Public — always returns `{"success": true}` regardless of whether the email exists
  (anti-enumeration). The actual reset token is emailed via SMTP
  (`infrastructure/email/sender.py`) — with no SMTP catcher wired into
  `docker-compose.yaml`, check the `api` container logs or the `password_reset_token`
  columns in Postgres to get the token for `Reset Password` below.
}
